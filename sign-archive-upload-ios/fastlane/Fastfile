default_platform(:ios)

# Gives each target the profile for its own bundle ID. With app extensions (a
# broadcast or share extension, a widget) one global PROVISIONING_PROFILE_SPECIFIER
# would hand the app's profile to targets with other bundle IDs and the archive
# would fail, so the profiles are written into the project per target instead.
def assign_profiles_per_target(workspace_path, profiles, team_id)
  require "xcodeproj"
  project_path = Dir[File.join(File.dirname(workspace_path), "*.xcodeproj")].first
  UI.user_error!("No .xcodeproj next to #{workspace_path}") unless project_path
  project = Xcodeproj::Project.open(project_path)
  signed = []
  project.native_targets.each do |target|
    target.build_configurations.each do |config|
      bundle_id = config.build_settings["PRODUCT_BUNDLE_IDENTIFIER"].to_s.delete('"')
      profile = profiles[bundle_id]
      next unless profile
      config.build_settings["CODE_SIGN_STYLE"] = "Manual"
      config.build_settings["DEVELOPMENT_TEAM"] = team_id
      config.build_settings["PROVISIONING_PROFILE_SPECIFIER"] = profile
      signed << bundle_id
      UI.message("#{target.name} (#{config.name}) → #{profile}")
    end
  end
  missing = profiles.keys - signed.uniq
  unless missing.empty?
    UI.user_error!("No target in #{File.basename(project_path)} builds #{missing.join(', ')}")
  end
  project.save
end

platform :ios do
  desc "Build and optionally upload an iOS app to TestFlight"
  lane :ios_build_upload do
    signing_mode = ENV.fetch("SIGNING_MODE")
    app_id       = ENV.fetch("APP_IDENTIFIER")
    team_id      = ENV.fetch("APPLE_TEAM_ID")
    # Bundle IDs of app extensions embedded in the app, each signed with its own profile.
    extension_ids = ENV.fetch("EXTENSION_IDENTIFIERS", "").split(/[\s,]+/).reject(&:empty?)
    if !extension_ids.empty? && signing_mode != "match"
      UI.user_error!("extension_identifiers is only supported with signing_mode: match")
    end

    # Build the API key object once — reused by match (if applicable) and pilot
    api_key = app_store_connect_api_key(
      key_id:                ENV.fetch("APPLE_API_KEY_ID"),
      issuer_id:             ENV.fetch("APPLE_API_ISSUER_ID"),
      key_content:           ENV.fetch("APPLE_API_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house:              false
    )

    profile_name = nil
    profile_uuid = nil
    extension_profiles = {}

    # ── Signing: match mode ─────────────────────────────────────────────────
    if signing_mode == "match"
      # Read the caller's choice before setup_ci: setup_ci unconditionally sets
      # ENV["MATCH_READONLY"] = "true", so reading it afterwards would make the
      # match_readonly input a no-op and a first-time profile could never be
      # created from CI.
      match_readonly = ENV.fetch("MATCH_READONLY", "true") != "false"

      # Creates a temporary keychain so match can import certs without GUI prompts
      setup_ci

      match(
        type:           ENV.fetch("MATCH_TYPE", "appstore"),
        app_identifier: [app_id] + extension_ids,
        readonly:       match_readonly,
        api_key:        api_key
      )

      # Derive profile name: "match AppStore org.example.app" unless explicitly overridden
      match_type   = ENV.fetch("MATCH_TYPE", "appstore")
      profile_name = ENV.fetch("PROFILE_NAME", "")
      profile_name = "match #{match_type.capitalize} #{app_id}" if profile_name.empty?
      # For "appstore" → "AppStore" (Fastlane convention)
      profile_name = profile_name.sub(/\bmatch appstore\b/i, "match AppStore")
      extension_profiles = extension_ids.to_h do |id|
        [id, "match #{match_type.capitalize} #{id}".sub(/\bmatch appstore\b/i, "match AppStore")]
      end

    elsif signing_mode == "cert-api"
      # cert-api mode: the .p12 cert is already imported into the temp keychain by
      # scripts/import-signing.sh. Download (don't create) the App Store
      # provisioning profile via the App Store Connect API key.
      get_provisioning_profile(
        api_key:        api_key,
        app_identifier: app_id,
        readonly:       true
      )
      profile_uuid = lane_context[SharedValues::SIGH_UUID]

    else
      # secrets mode: cert + profile already imported by scripts/import-signing.sh
      profile_uuid = ENV.fetch("PROFILE_UUID")
    end

    # ── Resolve workspace path (relative to app checkout, not action dir) ──
    ws_path = ENV.fetch("WORKSPACE_PATH")
    ws_path = File.join(ENV.fetch("GITHUB_WORKSPACE"), ws_path) unless ws_path.start_with?("/")

    # ── Build xcargs ────────────────────────────────────────────────────────
    xcargs_parts = [
      "CODE_SIGN_STYLE=Manual",
      "DEVELOPMENT_TEAM=#{team_id}"
    ]

    if signing_mode == "match" && extension_ids.empty?
      xcargs_parts << "PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\""
    elsif signing_mode == "match"
      assign_profiles_per_target(ws_path, { app_id => profile_name }.merge(extension_profiles), team_id)
    else
      # secrets / cert-api: reference the profile by UUID + point at the temp keychain
      xcargs_parts << "PROVISIONING_PROFILE_SPECIFIER=#{profile_uuid}"
      xcargs_parts << "OTHER_CODE_SIGN_FLAGS=\"--keychain #{ENV.fetch('KEYCHAIN_PATH')}\""
    end

    # ── Build export options ────────────────────────────────────────────────
    export_profiles = if signing_mode == "match"
      { app_id => profile_name }.merge(extension_profiles)
    else
      { app_id => profile_uuid }
    end

    # ── Archive + export IPA ────────────────────────────────────────────────
    gym(
      workspace:      ws_path,
      scheme:         ENV.fetch("XCODE_SCHEME"),
      configuration:  ENV.fetch("BUILD_CONFIGURATION", "Release"),
      export_method:  ENV.fetch("EXPORT_METHOD", "app-store"),
      xcargs:         xcargs_parts.join(" "),
      output_directory: ENV.fetch("OUTPUT_DIRECTORY"),
      export_options: {
        provisioningProfiles: export_profiles
      }
    )

    # ── Upload to TestFlight (optional) ─────────────────────────────────────
    unless ENV.fetch("UPLOAD_TO_TESTFLIGHT", "true") == "false"
      upload_to_testflight(
        api_key:                           api_key,
        skip_waiting_for_build_processing: true
      )
    end
  end
end
